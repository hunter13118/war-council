{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "war-council://schemas/session-summary.v1",
  "title": "SessionSummary",
  "description": "Aggregated analytics emitted at session close",
  "type": "object",
  "required": ["sessionId", "startTime", "totals", "performance", "efficiency"],
  "properties": {
    "sessionId": { "type": "string" },
    "startTime": { "type": "string", "format": "date-time" },
    "endTime": { "type": "string", "format": "date-time" },
    "durationMinutes": { "type": "number", "minimum": 0 },
    "totals": {
      "type": "object",
      "properties": {
        "toolCalls": { "type": "integer", "minimum": 0 },
        "chainRuns": { "type": "integer", "minimum": 0 },
        "tournaments": { "type": "integer", "minimum": 0 },
        "escalations": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 },
        "tokensIn": { "type": "integer", "minimum": 0 },
        "tokensOut": { "type": "integer", "minimum": 0 },
        "cloudCalls": { "type": "integer", "minimum": 0 }
      }
    },
    "performance": {
      "type": "object",
      "properties": {
        "avgToolLatencyMs": { "type": "number", "minimum": 0 },
        "p95ToolLatencyMs": { "type": "number", "minimum": 0 },
        "toolSuccessRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "chainCompletionRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "selfEvalPassRate": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "efficiency": {
      "type": "object",
      "properties": {
        "tokenWasteRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "contextUtilization": { "type": "number", "minimum": 0, "maximum": 1 },
        "memoryHitRate": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "topAgents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "agent": { "type": "string" },
          "calls": { "type": "integer" },
          "avgConfidence": { "type": "number" },
          "utilityScore": { "type": "number" }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "count": { "type": "integer" },
          "description": { "type": "string" }
        }
      }
    }
  }
}
