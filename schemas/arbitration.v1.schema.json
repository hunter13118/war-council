{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "war-council://schemas/arbitration.v1",
  "title": "ArbitrationRequest",
  "description": "Disagreement resolution when agents produce conflicting results",
  "type": "object",
  "required": ["type", "positions", "resolution_method"],
  "properties": {
    "type": { "enum": ["conflict", "tie", "ambiguous"] },
    "positions": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["agent", "tier", "position", "confidence"],
        "properties": {
          "agent": { "type": "string" },
          "tier": { "type": "string" },
          "position": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "reasoning": { "type": "string" }
        }
      }
    },
    "resolution_method": { "enum": ["judge", "vote", "escalate", "human"] },
    "judge": {
      "type": "object",
      "properties": {
        "agent": { "type": "string" },
        "tier": { "type": "string" }
      }
    }
  }
}
