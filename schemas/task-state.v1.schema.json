{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "war-council://schemas/task-state.v1",
  "title": "TaskState",
  "description": "Tracks where a task is in its lifecycle",
  "type": "object",
  "required": ["taskId", "state", "createdAt", "description"],
  "properties": {
    "taskId": { "type": "string", "format": "uuid" },
    "state": {
      "enum": ["pending", "routing", "in_progress", "escalated", "retrying", "review", "approved", "complete", "failed"]
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "description": { "type": "string" },
    "routing": {
      "type": "object",
      "properties": {
        "method": { "enum": ["smart_route", "explicit", "chain"] },
        "selectedTool": { "type": "string" },
        "selectedChain": { "type": ["string", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "execution": {
      "type": "object",
      "properties": {
        "assignedAgent": { "type": "string" },
        "tier": { "type": "string" },
        "startedAt": { "type": ["string", "null"], "format": "date-time" },
        "completedAt": { "type": ["string", "null"], "format": "date-time" },
        "durationMs": { "type": "integer", "minimum": 0 },
        "retryCount": { "type": "integer", "minimum": 0 },
        "maxRetries": { "type": "integer", "minimum": 0, "default": 3 }
      }
    },
    "result": {
      "type": "object",
      "properties": {
        "output": { "type": ["string", "null"] },
        "confidence": { "$ref": "war-council://schemas/confidence.v1" },
        "artifacts": { "type": "array", "items": { "type": "string" } },
        "tokensUsed": {
          "type": "object",
          "properties": {
            "in": { "type": "integer", "minimum": 0 },
            "out": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["timestamp", "fromState", "toState", "reason"],
        "properties": {
          "timestamp": { "type": "string", "format": "date-time" },
          "fromState": { "type": "string" },
          "toState": { "type": "string" },
          "reason": { "type": "string" },
          "agent": { "type": "string" }
        }
      }
    }
  }
}
