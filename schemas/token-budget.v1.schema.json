{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "war-council://schemas/token-budget.v1",
  "title": "TokenBudget",
  "description": "Context window discipline — prevents overflow on local models",
  "type": "object",
  "required": ["modelContext", "allocation", "overflow"],
  "properties": {
    "modelContext": {
      "type": "integer",
      "minimum": 1024,
      "description": "Model's total context window in tokens"
    },
    "allocation": {
      "type": "object",
      "required": ["systemPrompt", "taskDescription", "outputBudget"],
      "properties": {
        "systemPrompt": { "type": "integer", "minimum": 0, "default": 2048 },
        "taskDescription": { "type": "integer", "minimum": 0, "default": 1024 },
        "retrievedContext": { "type": "integer", "minimum": 0, "default": 8192 },
        "priorStepResults": { "type": "integer", "minimum": 0, "default": 4096 },
        "scratchpad": { "type": "integer", "minimum": 0, "default": 1024 },
        "reserved": { "type": "integer", "minimum": 0, "default": 2048 },
        "outputBudget": { "type": "integer", "minimum": 0, "default": 4096 }
      }
    },
    "overflow": {
      "type": "object",
      "required": ["strategy"],
      "properties": {
        "strategy": { "enum": ["truncate_oldest", "compress", "escalate_to_cloud"] },
        "compressionTool": { "type": "string", "default": "compress_context" },
        "cloudFallback": { "type": "string", "default": "strategic_plan" }
      }
    }
  }
}
