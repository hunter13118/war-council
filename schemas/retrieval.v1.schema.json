{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "war-council://schemas/retrieval.v1",
  "title": "RetrievalContract",
  "description": "Memory retrieval request and response schemas",
  "definitions": {
    "RetrievalRequest": {
      "type": "object",
      "required": ["query"],
      "properties": {
        "query": { "type": "string", "minLength": 1 },
        "options": {
          "type": "object",
          "properties": {
            "k": { "type": "integer", "minimum": 1, "maximum": 50, "default": 5 },
            "minRelevance": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.30 },
            "source": { "enum": ["code", "conversation", "decision", "all"], "default": "all" },
            "maxAge": { "type": ["string", "null"], "pattern": "^\\d+[dhm]$" },
            "tags": { "type": ["array", "null"], "items": { "type": "string" } },
            "budgetTokens": { "type": "integer", "minimum": 100, "default": 4000 }
          }
        }
      }
    },
    "RetrievalResponse": {
      "type": "object",
      "required": ["query", "chunks", "stats", "latency"],
      "properties": {
        "query": { "type": "string" },
        "chunks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "file", "text", "score"],
            "properties": {
              "id": { "type": "string" },
              "file": { "type": "string" },
              "startLine": { "type": "integer", "minimum": 0 },
              "text": { "type": "string" },
              "score": { "type": "number", "minimum": 0, "maximum": 1 },
              "metadata": { "type": "object" }
            }
          }
        },
        "stats": {
          "type": "object",
          "properties": {
            "totalChunks": { "type": "integer", "minimum": 0 },
            "scanned": { "type": "integer", "minimum": 0 },
            "returned": { "type": "integer", "minimum": 0 },
            "tokensUsed": { "type": "integer", "minimum": 0 }
          }
        },
        "latency": {
          "type": "object",
          "properties": {
            "embedMs": { "type": "integer", "minimum": 0 },
            "searchMs": { "type": "integer", "minimum": 0 },
            "totalMs": { "type": "integer", "minimum": 0 }
          }
        },
        "augmentedPrompt": { "type": "string" }
      }
    }
  }
}
