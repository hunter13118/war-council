{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "war-council://schemas/agent-message.v1",
  "title": "AgentMessage",
  "description": "Universal wire format for all inter-agent communication",
  "type": "object",
  "required": ["id", "timestamp", "source", "type", "payload"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "required": ["agent", "tier"],
      "properties": {
        "agent": { "type": "string" },
        "tier": { "enum": ["fast", "specialist", "reasoning", "heavy", "cloud", "human"] },
        "model": { "type": "string" }
      }
    },
    "target": {
      "type": "object",
      "properties": {
        "agent": { "type": "string" },
        "tier": { "type": "string" }
      }
    },
    "type": { "enum": ["request", "response", "escalation", "arbitration", "notification"] },
    "payload": {
      "type": "object",
      "properties": {
        "task": { "type": "string" },
        "context": { "type": "string" },
        "constraints": {
          "type": "object",
          "properties": {
            "maxTokensIn": { "type": "integer", "minimum": 0 },
            "maxTokensOut": { "type": "integer", "minimum": 0 },
            "timeoutMs": { "type": "integer", "minimum": 0 },
            "temperature": { "type": "number", "minimum": 0, "maximum": 2 }
          }
        },
        "result": { "type": ["string", "null"] },
        "confidence": { "$ref": "war-council://schemas/confidence.v1" },
        "artifacts": { "type": "array", "items": { "type": "string" } }
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "chainId": { "type": ["string", "null"] },
        "stepIndex": { "type": ["integer", "null"] },
        "retryCount": { "type": "integer", "minimum": 0, "default": 0 },
        "parentMessageId": { "type": ["string", "null"] }
      }
    }
  }
}
