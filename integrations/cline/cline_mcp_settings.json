{
  "mcpServers": {
    "war-council": {
      "type": "stdio",
      "command": "node",
      "args": ["{{WAR_COUNCIL_ROOT}}/mcp-server/server.js"],
      "env": {
        "OLLAMA_BASE": "http://127.0.0.1:11434",
        "REPO_ROOT": "{{WORKSPACE_ROOT}}",
        "WC_CALLER_CLIENT": "cline",
        "WC_CALLER_TIER": "cheap"
      },
      "disabled": false,
      "timeout": 120,
      "autoApprove": [
        "consult_fast",
        "consult_specialist",
        "consult_reasoning",
        "memory_query",
        "memory_stats",
        "list_arsenal",
        "smart_route",
        "self_eval",
        "tournament_vote"
      ]
    }
  }
}
