{
  "_instructions": "Windsurf: merge into ~/.codeium/windsurf/mcp_config.json, then refresh plugins in Cascade.",
  "mcpServers": {
    "war-council": {
      "command": "node",
      "args": ["{{WAR_COUNCIL_ROOT}}/mcp-server/server.js"],
      "env": {
        "OLLAMA_BASE": "http://127.0.0.1:11434",
        "REPO_ROOT": "{{WORKSPACE_ROOT}}",
        "WC_CALLER_CLIENT": "windsurf",
        "WC_CALLER_TIER": "premium"
      }
    }
  }
}
