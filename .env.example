# War Council environment — copy to .env and fill in. NEVER commit .env.
# All keys are OPTIONAL: without them the council runs fully local (Ollama only).

# --- Ollama ---
OLLAMA_BASE=http://127.0.0.1:11434
# OLLAMA_CONTEXT_LENGTH=32768
# OLLAMA_KEEP_ALIVE=30m

# --- Cloud failover (free tiers) — canonical hub; sync via scripts/sync-workspace-secrets.mjs ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=

# --- Image APIs (EbookAVPlayer freemium cascade) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
POLLINATIONS_TOKEN=
HF_TOKEN=

# --- Clerk (server JWT verify — NOT for storing Gemini keys) ---
CLERK_JWKS_URL=
CLERK_ISSUER=

# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=
# OPENROUTER_MODEL=

# --- Workspace ---
# REPO_ROOT=D:/path/to/active-workspace
# MEMORY_STORE_PATH=

# --- Caller identity (set by IDE client config) ---
# WC_CALLER_CLIENT=cursor|copilot|cline|roo|claude|gemini|antigravity|windsurf
# WC_CALLER_TIER=cheap|premium

# --- Ship-tier tuning (complexity fallback) ---
# WC_DEFER_TASK_CHARS=2400      # task descriptions longer than this defer to caller
# WC_HYBRID_TASK_CHARS=1200     # ...longer than this go hybrid
# WC_MAX_COUNCIL_FILES=8        # estimated files above this → hybrid
# WC_MAX_COUNCIL_LOC=400        # estimated LOC above this → hybrid

# --- Gates ---
# WC_SKIP_GATE=1                # bypass adherence git hooks (emergencies)
# GATEWAY_ENFORCEMENT=hard
