{
  "name": "war-council",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first AI agent orchestration — MCP server, War Table dashboard, Copilot agent framework",
  "scripts": {
    "start:mcp": "cd mcp-server && node server.js",
    "start:dashboard": "cd battle-log && node server.js",
    "test": "cd tests && node --test schemas.test.js documents.test.js integrity.test.js consistency.test.js samples.test.js",
    "test:schemas": "cd tests && node --test schemas.test.js",
    "test:docs": "cd tests && node --test documents.test.js",
    "test:integrity": "cd tests && node --test integrity.test.js",
    "test:consistency": "cd tests && node --test consistency.test.js",
    "test:samples": "cd tests && node --test samples.test.js",
    "test:ui": "cd tests && npx playwright test --config=playwright.config.js",
    "test:ui:mocked": "cd tests && npx playwright test --config=playwright.config.js --project=mocked",
    "test:ui:live": "cd tests && npx playwright test --config=playwright.config.js --project=live",
    "test:all": "cd tests && npm run test:all",
    "test:mcp": "cd mcp-server && npm test",
    "install:all": "cd mcp-server && npm install && cd ../tests && npm install"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hunter13118/war-council.git"
  },
  "author": "hunter13118",
  "license": "MIT",
  "dependencies": {
    "ws": "^8.20.1"
  }
}
